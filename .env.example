# Copy to .env and fill in. .env is gitignored; this template is tracked.
#   cp .env.example .env

# --- Database -----------------------------------------------------------
# Local dev (Homebrew postgresql@16):
#   LC_ALL=en_US.UTF-8 /opt/homebrew/opt/postgresql@16/bin/pg_ctl \
#     -D /opt/homebrew/var/postgresql@16 start
#   createdb cruxup
#   psql -d cruxup -f backend/app/db/migrations/0001_init.sql
#   DATABASE_URL=postgresql://localhost/cruxup python3 backend/app/catalog/seed.py
DATABASE_URL=

# Supabase is managed Postgres for this project -- no auth, no realtime, no
# storage (D4). Prefer DATABASE_URL + psycopg so the choice stays reversible.
SUPABASE_URL=
SUPABASE_KEY=

# --- Corpus sources -----------------------------------------------------
# D11: YouTube is the PRIMARY source. Needs only an API key, no approval queue.
YOUTUBE_API_KEY=

# D11: Reddit is OPTIONAL and non-load-bearing. Free tier is NON-COMMERCIAL
# only, and self-service registration is closed -- every OAuth client needs
# manual approval (2-4 weeks, may be refused). The collector runs without
# these; leave blank until an application is approved.  [W1-0c]
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# REQUIRED SECRET. Key for HMAC-pseudonymising author IDs before storage.
# Treat it like a password: YouTube channel IDs are public, so anyone holding
# this value can hash candidate IDs and match them against stored hashes.
# At least 32 random characters; the collector refuses to start otherwise.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Set once. Changing it makes previously stored hashes non-comparable.
CRUXUP_AUTHOR_SALT=

# --- LLM extraction  [W2-2] ---------------------------------------------
ANTHROPIC_API_KEY=
